{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether Terminal",
  "version": "0.0.1",
  "identifier": "local.jterm.frame-lab",
  "build": { "frontendDist": "../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Aether Terminal", "width": 960, "height": 720 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost 'self'; img-src 'self' data:" }
  },
  "bundle": { "active": false }
}
